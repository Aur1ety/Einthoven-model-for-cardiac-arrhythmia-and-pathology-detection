# Data (raw downloads and derived artifacts)
data/raw/*
data/cpsc2018/*
# data/ptbxl is a Windows junction to data/raw (vendor code needs a parent
# folder named 'ptbxl'). Git follows the junction, so ignore it explicitly or
# `git add -A` would stage the entire raw PTB-XL dataset (~2 GB, too large for
# git; re-download it from PhysioNet, where it is licensed CC BY 4.0).
data/ptbxl/
!data/raw/.gitkeep
!data/raw/scp_statements.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/einthoven_audit.csv
!data/processed/einthoven_audit_summary.md
!data/processed/vcg_kors_coefficients.json
!data/processed/diagnostic_mapping.csv

